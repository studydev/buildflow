# BuildFlow Pipeline Runner
#
# Per tasks.md T118: Create Dockerfile for pipeline jobs.
#
# This Dockerfile builds the container image for Azure Container Apps Jobs.
# It shares the same Python dependencies as the API but has a different entrypoint.
#
# Usage:
#   docker build -f Dockerfile.pipeline -t buildflow-pipeline:latest .
#   docker run -e PIPELINE_MESSAGE='{"run_id": "...", ...}' buildflow-pipeline:latest

FROM python:3.12-slim as base

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# ----------------------------------------------------------
# Builder stage - install dependencies
# ----------------------------------------------------------
FROM base as builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create and activate virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy dependency files
COPY pyproject.toml ./

# Install dependencies
RUN pip install --upgrade pip && \
    pip install .

# ----------------------------------------------------------
# Production stage - minimal runtime image
# ----------------------------------------------------------
FROM base as production

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash appuser

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY app/ ./app/

# Set ownership to non-root user
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Health check - runner exits after completion, so just check Python
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import app.pipelines.runner" || exit 1

# Default environment variables
ENV PYTHONPATH=/app \
    LOG_LEVEL=INFO

# Entrypoint for pipeline runner
# Message is passed via PIPELINE_MESSAGE environment variable
ENTRYPOINT ["python", "-m", "app.pipelines.runner"]

# No default CMD - requires PIPELINE_MESSAGE to be set
