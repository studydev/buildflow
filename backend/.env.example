# Environment
ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# API
API_V1_PREFIX=/api/v1

# Cosmos DB
# For local development connected to Azure Cosmos DB (recommended):
# Get connection string from Azure Portal > Cosmos DB > Settings > Keys > Primary Connection String
COSMOS_CONNECTION_STRING=AccountEndpoint=https://cosmos-buildflow-dev-yk6s7exodrar2.documents.azure.com:443/;AccountKey=your-primary-key-here
COSMOS_DATABASE_NAME=buildflow

# For local emulator (alternative - requires Docker):
# COSMOS_CONNECTION_STRING=AccountEndpoint=https://localhost:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# JWT (for future use)
# JWT_PRIVATE_KEY_PATH=keys/private.pem
# JWT_PUBLIC_KEY_PATH=keys/public.pem

# Azure OpenAI - GPT-5.2 for README Analysis
# Required for AI-powered content analysis from GitHub repositories
AZURE_OPENAI_ENDPOINT=your-endpoint-here
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Azure DALL-E Image Generation
AZURE_DALLE_DEPLOYMENT=gpt-image-1.5
AZURE_DALLE_IMAGE_SIZE=1536x1024

# Azure Storage (썸네일 업로드용)
# Azure Portal > Storage Accounts > stbuildflowdev... > Access keys 에서 확인
AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>
AZURE_STORAGE_ACCOUNT_KEY=<storage-account-key>

# Azure Communication Services (OTP Email)
# Required for sending OTP verification emails
# Get these from Azure Portal > Communication Services > Keys
ACS_CONNECTION_STRING=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key
ACS_SENDER_ADDRESS=DoNotReply@your-domain.azurecomm.net

# CORS Settings
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=

# GitHub Settings (for higher API rate limits)
# Get from https://github.com/settings/tokens
# GITHUB_TOKEN=your-github-token-here

# YouTube Settings
# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
# Required for fetching video metadata (title, duration, view count, etc.)
YOUTUBE_API_KEY=your-youtube-api-key-here

# External Transcript API (optional - use when youtube-transcript-api fails in cloud deployment)
# Leave empty to use local youtube-transcript-api library (default for local dev)
# YOUTUBE_TRANSCRIPT_API_URL=https://your-transcript-api.example.com
# YOUTUBE_TRANSCRIPT_API_KEY=your-transcript-api-key-here