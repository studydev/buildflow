# Environment
ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# API
API_V1_PREFIX=/api/v1

# Cosmos DB
# For local development connected to Azure Cosmos DB (recommended):
# Get connection string from Azure Portal > Cosmos DB > Settings > Keys > Primary Connection String
COSMOS_CONNECTION_STRING=AccountEndpoint=https://cosmos-buildflow-dev-yk6s7exodrar2.documents.azure.com:443/;AccountKey=your-primary-key-here
COSMOS_DATABASE_NAME=buildflow

# For local emulator (alternative - requires Docker):
# COSMOS_CONNECTION_STRING=AccountEndpoint=https://localhost:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==

# JWT (for future use)
# JWT_PRIVATE_KEY_PATH=keys/private.pem
# JWT_PUBLIC_KEY_PATH=keys/public.pem

# Azure OpenAI - GPT-5.2 for README Analysis
# Required for AI-powered content analysis from GitHub repositories
AZURE_OPENAI_ENDPOINT=https://genai-thon-04.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-5.2
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Azure Communication Services (OTP Email)
# Required for sending OTP verification emails
# Get these from Azure Portal > Communication Services > Keys
ACS_CONNECTION_STRING=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key
ACS_SENDER_ADDRESS=DoNotReply@your-domain.azurecomm.net